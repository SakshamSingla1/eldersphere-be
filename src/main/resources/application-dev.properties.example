# Copy this file to application-dev.properties and fill in real values for local development.
# application-dev.properties is git-ignored so secrets never get committed.

# ===============================
# APP CONFIGURATION
# ===============================
app.frontend.url=http://localhost:5173,http://localhost:3000
app.url=http://localhost:8080

# ===============================
# POSTGRESQL CONFIGURATION
# ===============================
spring.datasource.url=jdbc:postgresql://localhost:5432/eldersphere
spring.datasource.username=CHANGE_ME
spring.datasource.password=CHANGE_ME

# ===============================
# EMAIL CONFIGURATION (Gmail SMTP)
# ===============================
spring.mail.username=CHANGE_ME@gmail.com
spring.mail.password=CHANGE_ME_APP_PASSWORD

# ===============================
# JWT CONFIGURATION
# ===============================
jwt.secret=CHANGE_ME_BASE64_SECRET_MIN_32_CHARS
jwt.access-token.expiration=36000000

# ===============================
# PAYMENTS (Stripe) - get test keys at https://dashboard.stripe.com/test/apikeys
# ===============================
# stripe.secret-key=sk_test_CHANGE_ME
# stripe.publishable-key=pk_test_CHANGE_ME
# stripe.webhook-secret=whsec_CHANGE_ME

# ===============================
# FILE STORAGE (Cloudinary) - get credentials at https://console.cloudinary.com - leave
# commented to keep using local disk storage.
# ===============================
# cloudinary.cloud-name=CHANGE_ME
# cloudinary.api-key=CHANGE_ME
# cloudinary.api-secret=CHANGE_ME
